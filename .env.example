# VieSpeaker2 — environment variables.
#
# Fill in your keys. The loader (viespeaker.env) searches, in order:
#   1. $VIESPEAKER2_ENV_FILE                 (explicit override)
#   2. <repo>/.env                           (in-repo)
#   3. <repo_parent>/env/<repo_name>/.env    (sibling — keeps the repo clean)
# So on the server, ~/anhhd/sv/env/VieSpeaker2/.env is picked up automatically.
#
#   cp .env.example ../env/VieSpeaker2/.env   &&  edit it   # (recommended, outside repo)
#
# P1 CLOUD (default: pyannote/speaker-diarization-precision-2) — pyannoteAI key.
#   Create at https://dashboard.pyannote.ai
PYANNOTEAI_API_KEY=

# P1 LOCAL (pyannote/speaker-diarization-3.1) — HuggingFace access token.
#   Create at https://huggingface.co/settings/tokens and accept the model's gated terms.
HUGGINGFACE_ACCESS_TOKEN=
