# VieSpeaker2 — environment variables.
#
# Copy this file to .env (same directory) and fill in your keys. .env is
# gitignored, so it is NOT pulled onto the server — create it there once
# (see RUN_ON_SERVER.md). The pipelines auto-load .env from the repo root.
#
#   cp .env.example .env   &&  edit .env
#
# P1 CLOUD (default: pyannote/speaker-diarization-precision-2) — pyannoteAI key.
#   Create at https://dashboard.pyannote.ai
PYANNOTEAI_API_KEY=

# P1 LOCAL (pyannote/speaker-diarization-3.1) — HuggingFace access token.
#   Create at https://huggingface.co/settings/tokens and accept the model's gated terms.
HUGGINGFACE_ACCESS_TOKEN=
